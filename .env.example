# Pooled Neon connection for the application (hostname includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (unpooled) Neon connection for Prisma CLI migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Better Auth — generate secret with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-at-least-32-character-secret"
BETTER_AUTH_URL="http://localhost:3000"
