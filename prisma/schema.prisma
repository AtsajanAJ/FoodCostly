// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String                @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  currency    String?               @default("THB")
  timezone    String?               @default("Asia/Bangkok")
  locale      String?               @default("en")
  members     Member[]
  invitations Invitation[]
  categories       IngredientCategory[]
  ingredients      Ingredient[]
  suppliers        Supplier[]
  purchases        Purchase[]
  stockBalances    StockBalance[]
  inventoryLedger  InventoryLedgerEntry[]
  recipes          Recipe[]
  menuItems        MenuItem[]
  saleChannels     SaleChannel[]
  sales            Sale[]

  @@unique([slug])
  @@map("organization")
}

enum UnitDimension {
  WEIGHT
  VOLUME
  COUNT
}

enum IngredientStatus {
  ACTIVE
  ARCHIVED
}

/// System unit catalog (not tenant-owned). Canonical bases: g, ml, pcs.
model Unit {
  id           String        @id
  code         String        @unique
  name         String
  dimension    UnitDimension
  /// Multiply quantity in this unit by toBaseFactor to get canonical base quantity.
  toBaseFactor Decimal       @db.Decimal(24, 12)
  isBase       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ingredients   Ingredient[]
  purchaseLines PurchaseLine[]
  recipeItems   RecipeItem[]
  versionItems  RecipeVersionItem[]

  @@index([dimension])
  @@map("unit")
}

model IngredientCategory {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ingredients    Ingredient[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("ingredient_category")
}

model Ingredient {
  id                 String             @id
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name               String
  /// Canonical inventory / costing unit for this ingredient (exactly one).
  baseUnitId         String
  baseUnit           Unit               @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  minimumStock       Decimal?           @db.Decimal(24, 6)
  status             IngredientStatus   @default(ACTIVE)
  /// Last received purchase unit cost in organization currency (optional until purchases exist).
  latestPurchaseCost Decimal?           @db.Decimal(24, 6)
  /// Current inventory valuation cost (MWAC); maintained by inventory workflows later.
  valuationCost      Decimal?           @db.Decimal(24, 6)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  archivedAt         DateTime?
  purchaseLines      PurchaseLine[]
  stockBalance       StockBalance?
  ledgerEntries      InventoryLedgerEntry[]
  recipeItems        RecipeItem[]
  versionItems       RecipeVersionItem[]
  saleConsumptions   SaleStockConsumption[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([baseUnitId])
  @@map("ingredient")
}

enum RecipeStatus {
  ACTIVE
  ARCHIVED
}

enum MenuItemStatus {
  ACTIVE
  ARCHIVED
}

model Recipe {
  id             String          @id
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  /// Number of portions this recipe yields.
  portionCount   Decimal         @db.Decimal(24, 6)
  status         RecipeStatus    @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  items          RecipeItem[]
  versions       RecipeVersion[]
  menuItems      MenuItem[]
  saleItems      SaleItem[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("recipe")
}

/// Current editable recipe lines. Costing uses live MWAC unless a version snapshot is used.
model RecipeItem {
  id             String   @id
  organizationId String
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity       Decimal  @db.Decimal(24, 6)
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Edible yield percent (100 = no prep loss). Assumed at recipe-item level for MVP.
  yieldPercent   Decimal  @default(100) @db.Decimal(8, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_item")
}

/// Immutable cost snapshot. Updating ingredient MWAC later must not rewrite these rows.
model RecipeVersion {
  id              String              @id
  organizationId  String
  recipeId        String
  recipe          Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  versionNumber   Int
  portionCount    Decimal             @db.Decimal(24, 6)
  totalCost       Decimal             @db.Decimal(24, 6)
  costPerPortion  Decimal             @db.Decimal(24, 6)
  notes           String?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  items           RecipeVersionItem[]
  menuItems       MenuItem[]
  saleItems       SaleItem[]

  @@unique([recipeId, versionNumber])
  @@index([organizationId, recipeId])
  @@map("recipe_version")
}

model RecipeVersionItem {
  id                   String        @id
  organizationId       String
  recipeVersionId      String
  recipeVersion        RecipeVersion @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  ingredientId         String
  ingredient           Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity             Decimal       @db.Decimal(24, 6)
  unitId               String
  unit                 Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  baseQuantity         Decimal       @db.Decimal(24, 6)
  yieldPercent         Decimal       @db.Decimal(8, 4)
  /// Raw base qty required after yield loss (baseQuantity / yieldFraction).
  requiredBaseQuantity Decimal       @db.Decimal(24, 6)
  unitCostSnapshot     Decimal       @db.Decimal(24, 6)
  lineCostSnapshot     Decimal       @db.Decimal(24, 6)

  @@index([organizationId])
  @@index([recipeVersionId])
  @@index([ingredientId])
  @@map("recipe_version_item")
}

model MenuItem {
  id                 String         @id
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  recipeId           String
  recipe             Recipe         @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  /// Optional pinned snapshot; null means use latest published version for display.
  recipeVersionId    String?
  recipeVersion      RecipeVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: SetNull)
  priceInStore       Decimal?       @db.Decimal(24, 6)
  priceDelivery      Decimal?       @db.Decimal(24, 6)
  status             MenuItemStatus @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  archivedAt         DateTime?
  saleItems          SaleItem[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([recipeId])
  @@map("menu_item")
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT_GAIN
  STOCK_COUNT_LOSS
  SALE_CONSUMPTION
  SALE_REVERSAL
}

enum SaleChannelFeeType {
  NONE
  PERCENT
  FIXED
}

enum SaleChannelStatus {
  ACTIVE
  ARCHIVED
}

enum SaleStatus {
  POSTED
  CANCELLED
}

/// Org-scoped sales channel (in-store, delivery, …) with fee configuration.
model SaleChannel {
  id             String             @id
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Stable code such as INSTORE or DELIVERY (unique per org).
  code           String
  name           String
  feeType        SaleChannelFeeType @default(NONE)
  /// Percent (0–100) or fixed currency amount depending on feeType.
  feeValue       Decimal            @default(0) @db.Decimal(24, 6)
  status         SaleChannelStatus  @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sales          Sale[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("sale_channel")
}

/// Posted sale. Saving creates the sale and deducts stock in one transaction.
model Sale {
  id                   String       @id
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId            String
  channel              SaleChannel  @relation(fields: [channelId], references: [id], onDelete: Restrict)
  status               SaleStatus   @default(POSTED)
  soldAt               DateTime
  /// Client-supplied key; duplicate posts return the existing sale (idempotent).
  idempotencyKey       String
  currency             String
  notes                String?
  grossRevenue         Decimal      @db.Decimal(24, 6)
  discountAmount       Decimal      @default(0) @db.Decimal(24, 6)
  packagingCost        Decimal      @default(0) @db.Decimal(24, 6)
  channelFeeAmount     Decimal      @db.Decimal(24, 6)
  foodCostTotal        Decimal      @db.Decimal(24, 6)
  /// netRevenue − foodCost − packaging − channelFee (not net profit).
  contributionMargin   Decimal      @db.Decimal(24, 6)
  cancelledAt          DateTime?
  cancelReason         String?
  createdByUserId      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  items                SaleItem[]
  consumptions         SaleStockConsumption[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, soldAt])
  @@index([organizationId, channelId])
  @@map("sale")
}

model SaleItem {
  id                   String     @id
  organizationId       String
  saleId               String
  sale                 Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  menuItemId           String
  menuItem             MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  menuItemNameSnapshot String
  recipeId             String
  recipe               Recipe     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeVersionId      String?
  recipeVersion        RecipeVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict)
  quantity             Decimal    @db.Decimal(24, 6)
  unitPriceSnapshot    Decimal    @db.Decimal(24, 6)
  lineRevenue          Decimal    @db.Decimal(24, 6)
  foodCostSnapshot     Decimal    @db.Decimal(24, 6)
  createdAt            DateTime   @default(now())
  consumptions         SaleStockConsumption[]

  @@index([organizationId])
  @@index([saleId])
  @@index([menuItemId])
  @@map("sale_item")
}

/// Ingredient qty consumed by a sale line (audit + reversal source).
model SaleStockConsumption {
  id                String   @id
  organizationId    String
  saleId            String
  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItemId        String
  saleItem          SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityBase      Decimal  @db.Decimal(24, 6)
  unitCostSnapshot  Decimal  @db.Decimal(24, 6)
  totalCostSnapshot Decimal  @db.Decimal(24, 6)

  @@index([organizationId, saleId])
  @@index([saleItemId])
  @@index([ingredientId])
  @@map("sale_stock_consumption")
}

model Supplier {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  email          String?
  phone          String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("supplier")
}

model Purchase {
  id               String         @id
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchasedAt      DateTime
  invoiceNumber    String?
  status           PurchaseStatus @default(DRAFT)
  currency         String
  discountAmount   Decimal        @default(0) @db.Decimal(24, 6)
  taxAmount        Decimal        @default(0) @db.Decimal(24, 6)
  shippingAmount   Decimal        @default(0) @db.Decimal(24, 6)
  notes            String?
  receivedAt       DateTime?
  receivedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lines            PurchaseLine[]

  @@index([organizationId, status])
  @@index([organizationId, purchasedAt])
  @@index([supplierId])
  @@map("purchase")
}

model PurchaseLine {
  id                 String       @id
  organizationId     String
  purchaseId         String
  purchase           Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity           Decimal      @db.Decimal(24, 6)
  unitId             String
  unit               Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unitPrice          Decimal      @db.Decimal(24, 6)
  baseQuantity       Decimal      @db.Decimal(24, 6)
  lineGross          Decimal      @db.Decimal(24, 6)
  allocatedDiscount  Decimal      @default(0) @db.Decimal(24, 6)
  allocatedTax       Decimal      @default(0) @db.Decimal(24, 6)
  allocatedShipping  Decimal      @default(0) @db.Decimal(24, 6)
  allocatedCost      Decimal      @db.Decimal(24, 6)
  /// Historical cost per base unit at receive time; null while draft.
  baseUnitCost       Decimal?     @db.Decimal(24, 6)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
  @@index([purchaseId])
  @@index([ingredientId])
  @@map("purchase_line")
}

model StockBalance {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredientId   String       @unique
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantityBase   Decimal      @default(0) @db.Decimal(24, 6)
  valueTotal     Decimal      @default(0) @db.Decimal(24, 6)
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, ingredientId])
  @@map("stock_balance")
}

model InventoryLedgerEntry {
  id                    String                 @id
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ingredientId          String
  ingredient            Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movementType          InventoryMovementType
  quantityBase          Decimal                @db.Decimal(24, 6)
  unitCost              Decimal                @db.Decimal(24, 6)
  totalCost             Decimal                @db.Decimal(24, 6)
  balanceQuantityAfter  Decimal                @db.Decimal(24, 6)
  balanceValueAfter     Decimal                @db.Decimal(24, 6)
  occurredAt            DateTime
  reason                String?
  referenceType         String
  referenceId           String
  lineReferenceId       String?
  createdByUserId       String?
  createdAt             DateTime               @default(now())

  @@unique([organizationId, referenceType, referenceId, lineReferenceId, movementType])
  @@index([organizationId, ingredientId, occurredAt])
  @@index([organizationId, referenceType, referenceId])
  @@map("inventory_ledger_entry")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
